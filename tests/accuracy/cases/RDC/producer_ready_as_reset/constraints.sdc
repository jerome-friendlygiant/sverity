create_clock -name clk_src_i -period 8 [get_ports clk_src_i]
create_clock -name clk_dst_i -period 10 [get_ports clk_dst_i]
set_clock_groups -asynchronous -group [get_clocks clk_src_i] -group [get_clocks clk_dst_i]
set_input_delay 2 -clock clk_src_i [get_ports valid_src_i]
set_input_delay 2 -clock clk_dst_i [get_ports data_dst_i]
set_output_delay 2 -clock clk_dst_i [get_ports data_dst_o]
set_false_path -from [get_ports reset_ni]
