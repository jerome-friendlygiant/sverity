create_clock -name measured_clk -period 5.000 [get_ports clk_i]
create_clock -name reference_clk -period 10.000 [get_ports clk_ref_i]
set_input_delay  -clock measured_clk  -min 1.000 [get_ports en_i]
set_input_delay  -clock measured_clk -max 3.000 [get_ports en_i]
set_input_delay  -clock reference_clk -min 1.000 -add_delay [get_ports en_i]
set_input_delay  -clock reference_clk -max 3.000 -add_delay [get_ports en_i]
set_output_delay -clock measured_clk  -min 0.500 [get_ports {valid_o fast_o slow_o}]
set_output_delay -clock measured_clk -max 2.000 [get_ports {valid_o fast_o slow_o}]
set_output_delay -clock reference_clk -min 0.500 [get_ports ref_timeout_o]
set_output_delay -clock reference_clk -max 2.000 [get_ports ref_timeout_o]
