create_clock -name source -period 10 [get_ports src_clk]
create_clock -name destination -period 13 [get_ports dst_clk]
set_clock_groups -asynchronous -group [get_clocks source] -group [get_clocks destination]
set_output_delay -clock source -min 0 [get_ports a*]
set_output_delay -clock source -max 2 [get_ports a*]
set_output_delay -clock destination -min 0 [get_ports b*]
set_output_delay -clock destination -max 2 [get_ports b*]
