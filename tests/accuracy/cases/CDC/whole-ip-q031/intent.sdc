create_clock -name clk_a -period 10 [get_ports clk_a]
create_clock -name clk_b -period 10 [get_ports clk_b]
set_clock_groups -asynchronous -group [get_clocks clk_a] -group [get_clocks clk_b]
create_clock -name async_ext -period 10 [get_ports data_i]
set_input_delay -clock async_ext -max 2 [get_ports data_i]
set_input_delay -clock async_ext -min 0 [get_ports data_i]
set_clock_groups -asynchronous -group [get_clocks async_ext] -group [get_clocks clk_a] -group [get_clocks clk_b]
set_output_delay -clock clk_b -max 1 [get_ports data_o]
set_output_delay -clock clk_b -min 0 [get_ports data_o]
set_output_delay -clock clk_b -max 1 [get_ports event_o]
set_output_delay -clock clk_b -min 0 [get_ports event_o]
